#!/usr/bin/env bash
#
# pvpn-autoconnect — put the tunnel back after the network moved under it.
#
#   pvpn-autoconnect            reconnect, if the network is up and no tunnel is
#   pvpn-autoconnect --off      stop reconnecting automatically
#   pvpn-autoconnect --on       resume reconnecting automatically
#   pvpn-autoconnect --status   report which of those is in effect
#
# A deliberate `pvpn down` is never undone: it leaves a marker that survives
# a suspend, and only `pvpn up` or `pvpn hop` clears it.
#
# It only reconnects on networks `autoconnect_networks` allows in
# ~/.config/pvpn/config.toml: "started" (default — wherever you last ran
# `pvpn up`), "all", or a list such as ["detnsw", "wired:eth0"].
#
# This is not the old pvpnd. It does not poll, it holds no `want_up`, and it
# is not running right now. Something that already happened starts it — a
# resume, or a physical link coming up — and it makes a few attempts and
# exits. On a network that refuses every connect it gives up and stays quiet
# instead of fighting you forever. See docs/always-on.md.
#
set -u

MARKER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pvpn"
MARKER="$MARKER_DIR/autoconnect-off"
# Written by `pvpn down` and cleared by `pvpn up` / `pvpn hop`. Two separate
# facts: this one is "the tunnel is off because I asked just now", the marker
# above is "never reconnect for me at all". `pvpn up` must clear the first
# without quietly undoing the second.
DOWN_MARKER="${XDG_DATA_HOME:-$HOME/.local/share}/pvpn/down-by-user"
ATTEMPTS="${PVPN_AUTOCONNECT_ATTEMPTS:-3}"
LINK_WAIT="${PVPN_AUTOCONNECT_LINK_WAIT:-60}"

case "${1:-}" in
    --off)
        mkdir -p "$MARKER_DIR" && : > "$MARKER"
        echo "autoconnect off — nothing will rebuild the tunnel for you."
        exit 0
        ;;
    --on)
        rm -f "$MARKER"
        echo "autoconnect on — the tunnel comes back after a resume or a link change."
        exit 0
        ;;
    --status)
        if [[ -e "$MARKER" ]]; then
            echo "off  (remove $MARKER, or run: pvpn-autoconnect --on)"
        elif [[ -e "$DOWN_MARKER" ]]; then
            echo "on   but holding: you ran \`pvpn down\`, so a resume will"
            echo "     leave the tunnel down. \`pvpn up\` releases the hold."
        else
            echo "on   (disable with: pvpn-autoconnect --off)"
        fi
        pvpn_bin="$(command -v pvpn || echo "$HOME/.local/bin/pvpn")"
        if [[ -x "$pvpn_bin" ]] && scope="$("$pvpn_bin" autoconnect-check 2>/dev/null; true)" \
            && [[ -n "$scope" ]]; then
            echo "     $scope"
        fi
        exit 0
        ;;
    -h|--help)
        sed -n '3,15p' "$0" | sed 's/^# \?//'
        exit 0
        ;;
    "") ;;
    *)
        echo "Unknown option: $1 (try --help)" >&2
        exit 1
        ;;
esac

# Never reconnect at all.
[[ -e "$MARKER" ]] && exit 0

# A deliberate `pvpn down` should stick, including across a suspend. This is
# the whole reason the marker exists: without it, locking the laptop after
# turning the VPN off would turn it back on again.
[[ -e "$DOWN_MARKER" ]] && exit 0

# One autoconnect at a time. The connects themselves are serialised by
# pvpn's own lock (crates/pvpn-core/src/lock.rs): an overlap with a manual
# `pvpn up`/`hop` waits its turn instead of fighting — two overlapping
# connects are what strand the kill switch, and the protun plugin refuses
# the second one outright. This flock only keeps two of *this script* from
# queueing connects nobody needs.
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 9>"$runtime/pvpn-autoconnect.lock" || exit 0
flock -n 9 || exit 0

# A route through the tunnel, *and* something coming back through it.
#
# The route alone was the old test, and it is the same mistake NetworkManager
# and Proton's own client make: a tunnel whose session the network killed
# keeps its device and its routes. Measured 2026-09-15 on detnsw — protun-tcp
# carried for three minutes, the middlebox killed the carrier, and this
# function went on returning true over a tunnel that had not passed a packet
# in two minutes, so autoconnect exited 0 with nothing to show for it.
#
# The route is checked first because it is free and it is the cheaper "no".
# The probe only runs when there is something for it to be about.
tunnel_up() {
    tunnel_routed && tunnel_carries
}

# The cheap half on its own, for the places that only need to know whether a
# tunnel *exists* — the wait loop below, which must not spend six seconds per
# iteration probing one.
tunnel_routed() {
    ip route get 1.1.1.1 2>/dev/null | grep -qE 'dev proton[0-9]*'
}

# Does anything answer through it? Two endpoints, whichever replies first, so
# a healthy tunnel costs one round trip. Deliberately not a ping: ICMP is
# dropped wholesale on the networks this tool exists for.
tunnel_carries() {
    local url
    for url in https://www.gstatic.com/generate_204 http://detectportal.firefox.com/success.txt; do
        curl -s -4 --noproxy '*' --max-time 3 -o /dev/null "$url" && return 0
    done
    return 1
}

# A default route that is not the tunnel's own — i.e. something real to
# build a tunnel over.
underlay_up() {
    ip route show default 2>/dev/null \
        | grep -qv ' dev \(proton[0-9]*\|ipv6leakintrf0\|pvpnksintrf0\)'
}

# On resume NetworkManager reassociates several seconds after the kernel
# comes back, so wait for the link rather than failing a connect against a
# network that is not there yet. Only the cheap route test runs in here: a
# tunnel that is merely *present* is enough to stop waiting, and whether it
# is any good is one question asked once, below.
for ((i = 0; i < LINK_WAIT; i++)); do
    tunnel_routed && break
    underlay_up && break
    sleep 1
done

# A tunnel that is up and carrying is the whole job already done.
tunnel_up && exit 0

# Past here something needs rebuilding — either there was no tunnel, or there
# was one and it has stopped carrying. Both need an underlay to build over.
underlay_up || exit 0

pvpn_bin="$(command -v pvpn || echo "$HOME/.local/bin/pvpn")"
[[ -x "$pvpn_bin" ]] || { echo "pvpn not found on PATH" >&2; exit 1; }

# Only on a network you chose (autoconnect_networks). Asked after the wait
# above, so the answer is about the network we actually landed on.
if ! scope="$("$pvpn_bin" autoconnect-check)"; then
    echo "$scope"
    exit 0
fi

# Tells pvpn this `up` is ours, not the user's, so it does not move the
# "started" network it was just checked against.
export PVPN_AUTOCONNECT=1

# Bounded. protun-tcp lands in seconds on a friendly network and protun-tls
# can take a minute and a half on a filtered one, so pvpn is never given a
# deadline here — killing it mid-connect is what strands the kill switch and
# takes all internet with it.
for ((attempt = 1; attempt <= ATTEMPTS; attempt++)); do
    tunnel_up && exit 0
    "$pvpn_bin" up && tunnel_up && exit 0
    [[ $attempt -lt $ATTEMPTS ]] && sleep $((attempt * 20))
done
exit 1
