#!/usr/bin/env bash
# vpn-check - will a VPN work on the wifi I'm on right now?
# Run it on any network. No arguments, nothing to configure.
#
#   vpn-check                 human-readable report
#   vpn-check --machine FILE  also write KEY=value results to FILE (for setup.sh)
#
set -uo pipefail

MACHINE_OUT=""
if [[ "${1:-}" == "--machine" ]]; then
  MACHINE_OUT="${2:-}"
  [[ -n "$MACHINE_OUT" ]] || { echo "usage: vpn-check --machine FILE" >&2; exit 2; }
fi

write_machine() {
  [[ -n "$MACHINE_OUT" ]] || return 0
  cat >"$MACHINE_OUT"
}

c(){ printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
ok(){ c '1;32' "  PASS  $1"; }; bad(){ c '1;31' "  FAIL  $1"; }; note(){ c '0;37' "        $1"; }

SSID=$(nmcli -t -f ACTIVE,SSID device wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
c '1;36' "Network: ${SSID:-unknown}   $(ip -4 route show default | awk '{print "via "$3" dev "$5; exit}')"
echo

pass=0; fail=0
INTERNET=0; PROTON_TCP=0; UDP=0; DNS_HIJACK=0; TLS_PROXY=0
DNS_SERVER=""

# 1. Baseline: is the internet up at all?
if curl -s --max-time 8 -o /dev/null https://github.com; then
  ok "basic internet"; ((pass++)); INTERNET=1
else
  bad "no internet at all - nothing else matters"
  write_machine <<EOF
internet=0
proton_tcp=0
udp=0
dns_hijack=0
tls_proxy=0
dns_server=''
ssid=$(printf '%q' "${SSID:-}")
verdict=no_internet
EOF
  exit 1
fi

# 2. Proton VPN server IPs on TCP/443. These are real Proton endpoints; if a
#    TLS handshake completes, the provider is not IP-blocked here.
protok=0
for ip in 156.47.78.177 212.104.101.106 89.187.170.159; do
  if timeout 12 openssl s_client -connect "$ip:443" -servername www.google.com </dev/null 2>&1 \
       | grep -q 'BEGIN CERTIFICATE'; then protok=1; break; fi
done
if ((protok)); then
  ok "Proton VPN servers reachable on TCP/443"; ((pass++)); PROTON_TCP=1
else
  bad "Proton VPN server IPs are dropped on TCP/443"; ((fail++))
  note "the network blocks the provider by address - Stealth/OpenVPN-TCP cannot help"
fi

# 3. Is a transparent proxy terminating TLS? RFC 5737 TEST-NET addresses are
#    reserved for documentation - nothing listens on them anywhere. If TCP/443
#    to one "succeeds", a local box answered on its behalf, which means every
#    result above describes that box and not the server you asked for.
for ip in 198.51.100.77 203.0.113.9 192.0.2.55; do
  if timeout 5 bash -c "exec 3<>/dev/tcp/$ip/443" 2>/dev/null; then TLS_PROXY=1; break; fi
done
if ((TLS_PROXY)); then
  bad "a transparent proxy is terminating TLS here"; ((fail++))
  note "it answered for an address that does not exist, so 'reachable' above"
  note "means reachable to the proxy. Such a proxy can complete the TLS"
  note "handshake and close the session a moment later - see"
  note "docs/transparent-proxy.md"
else
  ok "no transparent TLS proxy detected"; ((pass++))
fi

# 4. General UDP egress, using a non-Google STUN server (Google is often
#    allowlisted for Meet, which would give a false pass).
if /usr/bin/python3 - <<'PY' 2>/dev/null
import socket, struct, sys
tid=b'\x21\x12\xa4\x42'+b'\x09'*12
for host in ("stun.cloudflare.com","stun.nextcloud.com"):
    try: ip=socket.gethostbyname(host)
    except Exception: continue
    for port in (3478,443):
        s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.settimeout(4)
        try:
            s.sendto(struct.pack('>HH',1,0)+tid,(ip,port)); s.recvfrom(2048); sys.exit(0)
        except Exception: pass
        finally: s.close()
sys.exit(1)
PY
then
  ok "general UDP egress works"; ((pass++)); UDP=1
else
  bad "UDP blocked except to allowlisted hosts"; ((fail++))
  note "usually the wifi filter (not your laptop firewall)"
  note "kills WireGuard/OpenVPN-UDP — use Stealth (protun-tls) instead"
fi

# 5. Is DNS forced to a local resolver?
DNS=$(resolvectl status 2>/dev/null | awk '/Current DNS Server/{print $NF; exit}')
DNS_SERVER="${DNS:-}"
if [[ $DNS =~ ^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.) ]]; then
  bad "DNS forced to local resolver ($DNS)"; ((fail++)); DNS_HIJACK=1
else
  ok "DNS not hijacked (${DNS:-unknown})"; ((pass++))
fi

echo
VERDICT="ok"
if ((fail==0)); then
  c '1;32' "VERDICT: a VPN should work here. Try:  pvpn up"
  VERDICT="ok"
elif ((TLS_PROXY)) && ((protok)); then
  c '1;33' "VERDICT: a transparent proxy terminates TLS on this network."
  note "Stealth can still get through, but expect many refused attempts"
  note "before one sticks. Give 'pvpn up' time and re-run it if it gives up."
  VERDICT="proxied"
elif ((protok)); then
  c '1;33' "VERDICT: partly filtered. Proton is reachable, so try:  pvpn try"
  note "prefer Stealth (TCP/443):  pvpn up protun-tls"
  VERDICT="partial"
else
  c '1;31' "VERDICT: VPNs are blocked by address on this network."
  note "Not fixable from this machine, on any OS. Try another SSID"
  note "(doe-guest / BYOD) or a phone hotspot, then run vpn-check again."
  VERDICT="blocked"
fi

write_machine <<EOF
internet=$INTERNET
proton_tcp=$PROTON_TCP
udp=$UDP
dns_hijack=$DNS_HIJACK
tls_proxy=$TLS_PROXY
dns_server=$(printf '%q' "$DNS_SERVER")
ssid=$(printf '%q' "${SSID:-}")
verdict=$VERDICT
EOF
