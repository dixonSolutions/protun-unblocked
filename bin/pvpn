#!/usr/bin/env bash
#
# Checkout helper. The real CLI is the Rust binary installed to
# ~/.local/bin/pvpn by ./setup.sh. This stub finds a built copy so
# `./bin/pvpn help` still works from a git checkout.
#
# The previous bash implementation lives at legacy/pvpn.sh (deprecated).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$HERE")"

if [[ -x "$HOME/.local/bin/pvpn" ]] && [[ "$HOME/.local/bin/pvpn" -ef "$0" ]]; then
    : # we *are* the installed path somehow; fall through
elif [[ -x "$HOME/.local/bin/pvpn" ]]; then
    # Make sure we are not exec'ing ourselves.
    if ! grep -q 'Checkout helper' "$HOME/.local/bin/pvpn" 2>/dev/null; then
        exec "$HOME/.local/bin/pvpn" "$@"
    fi
fi

for candidate in "$REPO/target/release/pvpn" "$REPO/target/debug/pvpn"; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

echo "pvpn: Rust CLI is not built yet." >&2
echo "  cargo build -p pvpn" >&2
echo "  # or:  ./setup.sh" >&2
echo "The old bash script is at legacy/pvpn.sh (deprecated)." >&2
exit 1
